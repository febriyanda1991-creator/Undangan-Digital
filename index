<style>

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

html{
  scroll-behavior:smooth;
}

body{
  font-family:Georgia,"Times New Roman",serif;
  background:#111;
  color:#eee;
  overflow-x:hidden;
}

.container{
  width:100%;
  max-width:480px;
  margin:auto;
  background:#090909;
  min-height:100vh;
  overflow:hidden;
}

/* ================================
   WARNA UTAMA
================================ */

:root{
  --gold:#d4af37;
  --gold-light:#f1d77b;
  --black:#080808;
  --dark:#111;
  --white:#fff;
  --gray:#aaa;
}

/* ================================
   COVER
================================ */

.cover{
  position:relative;
  min-height:100vh;
  display:flex;
  align-items:center;
  justify-content:center;
  text-align:center;
  padding:25px;
  overflow:hidden;

  background:
    linear-gradient(
      rgba(0,0,0,.55),
      rgba(0,0,0,.78)
    ),
    var(--cover-photo)
    center/cover no-repeat;
}

/* cahaya bergerak */

.cover::before{
  content:"";
  position:absolute;
  width:280px;
  height:280px;
  border-radius:50%;
  background:rgba(212,175,55,.12);
  filter:blur(30px);
  animation:glowMove 6s ease-in-out infinite alternate;
}

@keyframes glowMove{
  0%{
    transform:translate(-100px,-100px);
  }
  100%{
    transform:translate(100px,100px);
  }
}

/* ornamen */

.ornament{
  position:absolute;
  color:var(--gold);
  opacity:.7;
  font-size:25px;
  pointer-events:none;
}

.o1{
  top:12%;
  left:12%;
  animation:float1 5s ease-in-out infinite;
}

.o2{
  top:20%;
  right:10%;
  animation:float2 6s ease-in-out infinite;
}

.o3{
  bottom:18%;
  left:8%;
  animation:float2 7s ease-in-out infinite;
}

.o4{
  bottom:12%;
  right:12%;
  animation:float1 5s ease-in-out infinite;
}

@keyframes float1{
  0%,100%{
    transform:translateY(0) rotate(0deg);
  }

  50%{
    transform:translateY(-25px) rotate(15deg);
  }
}

@keyframes float2{
  0%,100%{
    transform:translate(0,0) rotate(0deg);
  }

  50%{
    transform:translate(15px,-20px) rotate(-15deg);
  }
}

/* cover box */

.cover-box{
  position:relative;
  z-index:5;
  width:100%;
  padding:45px 25px;

  border:1px solid rgba(212,175,55,.8);

  background:rgba(0,0,0,.55);

  backdrop-filter:blur(6px);

  animation:coverBox 1.5s ease forwards;
}

@keyframes coverBox{
  from{
    opacity:0;
    transform:scale(.85) translateY(40px);
  }

  to{
    opacity:1;
    transform:scale(1) translateY(0);
  }
}

.small-title{
  font-size:13px;
  letter-spacing:5px;
  color:var(--gold-light);
  margin-bottom:25px;

  animation:fadeDown 1.2s ease;
}

.cover h1{
  font-size:42px;
  line-height:1.15;
  font-weight:normal;
  color:white;

  animation:titleZoom 1.5s ease;
}

@keyframes titleZoom{
  from{
    opacity:0;
    transform:scale(.5);
  }

  to{
    opacity:1;
    transform:scale(1);
  }
}

.cover-date{
  margin-top:18px;
  color:var(--gold-light);
  letter-spacing:4px;
  font-size:15px;

  animation:fadeUp 1.5s ease;
}

/* foto cover */

.cover-photo{
  width:145px;
  height:145px;
  object-fit:cover;
  border-radius:50%;

  border:4px solid var(--gold);

  margin:30px auto;

  box-shadow:
    0 0 0 8px rgba(212,175,55,.12),
    0 0 40px rgba(212,175,55,.35);

  animation:
    photoFloat 4s ease-in-out infinite,
    photoAppear 1.5s ease;
}

@keyframes photoFloat{
  0%,100%{
    transform:translateY(0);
  }

  50%{
    transform:translateY(-10px);
  }
}

@keyframes photoAppear{
  from{
    opacity:0;
    transform:scale(.4);
  }

  to{
    opacity:1;
  }
}

/* tombol */

.open-btn{
  display:inline-block;
  padding:14px 28px;

  border:1px solid var(--gold);

  color:white;

  text-decoration:none;

  letter-spacing:2px;

  border-radius:30px;

  background:rgba(212,175,55,.12);

  animation:pulseButton 2s infinite;

  transition:.3s;
}

.open-btn:hover{
  background:var(--gold);
  color:#000;
}

@keyframes pulseButton{
  0%,100%{
    box-shadow:0 0 0 0 rgba(212,175,55,.4);
  }

  50%{
    box-shadow:0 0 0 12px rgba(212,175,55,0);
  }
}

/* ================================
   TEXT BERJALAN
================================ */

.marquee{
  width:100%;
  overflow:hidden;
  border-top:1px solid rgba(212,175,55,.3);
  border-bottom:1px solid rgba(212,175,55,.3);

  padding:14px 0;

  white-space:nowrap;

  color:var(--gold);

  font-size:13px;

  letter-spacing:3px;
}

.marquee-track{
  display:inline-block;

  padding-left:100%;

  animation:marquee 18s linear infinite;
}

@keyframes marquee{
  from{
    transform:translateX(0);
  }

  to{
    transform:translateX(-100%);
  }
}

/* ================================
   SECTION
================================ */

section{
  position:relative;
  padding:70px 25px;
  text-align:center;
}

.section-label{
  color:var(--gold);
  font-size:11px;
  letter-spacing:4px;
  text-transform:uppercase;
  margin-bottom:14px;
}

section h2{
  font-size:31px;
  font-weight:normal;
  color:white;
}

.divider{
  width:60px;
  height:1px;
  background:var(--gold);
  margin:22px auto;
}

/* ================================
   OPENING
================================ */

.opening{
  background:#090909;
}

.opening p{
  color:#bbb;
  font-family:Arial,sans-serif;
  font-size:14px;
  line-height:1.9;
}

/* ================================
   COUPLE
================================ */

.couple{
  background:
    radial-gradient(
      circle at center,
      #191919,
      #080808
    );
}

.couple-grid{
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:25px;
}

.person{
  width:100%;
}

.person-photo{
  width:130px;
  height:130px;
  border-radius:50%;
  object-fit:cover;

  border:3px solid var(--gold);

  box-shadow:
    0 0 25px rgba(212,175,55,.25);

  animation:coupleFloat 5s ease-in-out infinite;
}

.person:nth-child(2) .person-photo{
  animation-delay:1s;
}

@keyframes coupleFloat{
  0%,100%{
    transform:translateY(0);
  }

  50%{
    transform:translateY(-8px);
  }
}

.couple-name{
  margin-top:15px;
  font-size:28px;
  color:var(--gold-light);
}

.couple-role{
  margin-top:7px;
  color:#aaa;
  font-family:Arial,sans-serif;
  font-size:12px;
  line-height:1.6;
}

.and{
  color:var(--gold);
  font-size:35px;
}

/* ================================
   COUNTDOWN
================================ */

.countdown{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:7px;
}

.time-box{
  padding:15px 4px;

  border:1px solid rgba(212,175,55,.35);

  background:#111;

  border-radius:6px;

  animation:timePulse 2s ease-in-out infinite;
}

.time-box:nth-child(2){
  animation-delay:.2s;
}

.time-box:nth-child(3){
  animation-delay:.4s;
}

.time-box:nth-child(4){
  animation-delay:.6s;
}

@keyframes timePulse{
  0%,100%{
    transform:translateY(0);
  }

  50%{
    transform:translateY(-4px);
  }
}

.time-box strong{
  display:block;
  font-size:22px;
  color:var(--gold-light);
}

.time-box span{
  display:block;
  margin-top:5px;
  font-family:Arial,sans-serif;
  font-size:9px;
  color:#999;
  text-transform:uppercase;
}

/* ================================
   EVENT
================================ */

.event{
  background:#0d0d0d;
}

.event-card{
  position:relative;

  padding:30px 18px;

  margin:20px 0;

  border:1px solid rgba(212,175,55,.35);

  background:
    linear-gradient(
      145deg,
      #151515,
      #090909
    );

  overflow:hidden;

  transition:.4s;
}

.event-card::before{
  content:"";
  position:absolute;
  width:80px;
  height:80px;
  border-radius:50%;
  background:rgba(212,175,55,.08);
  top:-30px;
  right:-30px;
}

.event-card:hover{
  transform:translateY(-7px);
  border-color:var(--gold);
}

.event-card h3{
  color:var(--gold);
  font-size:24px;
  font-weight:normal;
  margin-bottom:15px;
}

.event-card p{
  color:#aaa;
  font-family:Arial,sans-serif;
  font-size:13px;
  line-height:1.8;
}

.map-btn{
  display:inline-block;

  margin-top:18px;

  padding:11px 22px;

  border:1px solid var(--gold);

  color:var(--gold-light);

  text-decoration:none;

  border-radius:25px;

  font-family:Arial,sans-serif;

  font-size:12px;

  transition:.3s;
}

.map-btn:hover{
  background:var(--gold);
  color:#000;
}

/* ================================
   GALERI
================================ */

.gallery{
  background:#090909;
}

.gallery-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:9px;
}

.gallery-grid img{
  width:100%;
  height:190px;

  object-fit:cover;

  border:1px solid rgba(212,175,55,.2);

  transition:
    transform .6s ease,
    filter .6s ease;
}

.gallery-grid img:hover{
  transform:scale(1.05);
  filter:brightness(1.2);
}

/* ================================
   RSVP
================================ */

.rsvp{
  background:#101010;
}

form{
  text-align:left;
}

label{
  display:block;
  margin:15px 0 7px;

  color:#bbb;

  font-family:Arial,sans-serif;

  font-size:12px;
}

input,
select,
textarea{
  width:100%;

  padding:13px;

  border:1px solid #333;

  background:#080808;

  color:white;

  border-radius:5px;

  outline:none;

  font-family:Arial,sans-serif;
}

textarea{
  min-height:90px;
  resize:none;
}

input:focus,
select:focus,
textarea:focus{
  border-color:var(--gold);
}

.submit-btn{
  width:100%;

  margin-top:20px;

  padding:14px;

  border:1px solid var(--gold);

  border-radius:30px;

  background:var(--gold);

  color:#000;

  font-weight:bold;

  cursor:pointer;

  transition:.3s;
}

.submit-btn:hover{
  background:var(--gold-light);
}

/* ================================
   GIFT
================================ */

.gift{
  background:#090909;
}

.gift-box{
  padding:28px 20px;

  border:1px solid rgba(212,175,55,.35);

  background:#111;

  font-family:Arial,sans-serif;

  font-size:14px;

  line-height:1.8;

  color:#aaa;
}

.bank-name{
  color:var(--gold);
  font-size:20px;
  margin-bottom:5px;
}

.account-number{
  font-size:22px;
  color:white;
  letter-spacing:2px;
}

.copy-btn{
  margin-top:15px;

  padding:10px 20px;

  border:1px solid var(--gold);

  background:transparent;

  color:var(--gold);

  border-radius:25px;

  cursor:pointer;
}

/* ================================
   FOOTER
================================ */

footer{
  padding:55px 20px;

  text-align:center;

  background:#050505;

  border-top:1px solid rgba(212,175,55,.2);
}

footer h2{
  color:var(--gold);
  font-weight:normal;
}

footer p{
  margin-top:10px;
  color:#777;
  font-family:Arial,sans-serif;
  font-size:11px;
}

/* ================================
   MUSIK
================================ */

.music-btn{
  position:fixed;

  right:18px;
  bottom:18px;

  width:50px;
  height:50px;

  border-radius:50%;

  border:1px solid var(--gold);

  background:#111;

  color:var(--gold);

  font-size:19px;

  z-index:99;

  box-shadow:0 0 20px rgba(212,175,55,.2);

  cursor:pointer;
}

.music-btn.playing{
  animation:musicSpin 3s linear infinite;
}

@keyframes musicSpin{
  from{
    transform:rotate(0);
  }

  to{
    transform:rotate(360deg);
  }
}

/* ================================
   SCROLL ANIMATION
================================ */

.reveal{
  opacity:0;

  transform:
    translateY(50px)
    scale(.97);

  transition:
    opacity 1s ease,
    transform 1s ease;
}

.reveal.show{
  opacity:1;

  transform:
    translateY(0)
    scale(1);
}

/* ================================
   FADE
================================ */

@keyframes fadeDown{
  from{
    opacity:0;
    transform:translateY(-30px);
  }

  to{
    opacity:1;
    transform:translateY(0);
  }
}

@keyframes fadeUp{
  from{
    opacity:0;
    transform:translateY(30px);
  }

  to{
    opacity:1;
    transform:translateY(0);
  }
}

/* ================================
   PETAL
================================ */

.petal{
  position:fixed;

  top:-30px;

  color:var(--gold);

  font-size:15px;

  pointer-events:none;

  z-index:2;

  animation:fall linear forwards;
}

@keyframes fall{

  0%{
    transform:
      translateY(-30px)
      rotate(0deg);
    opacity:0;
  }

  10%{
    opacity:.7;
  }

  100%{
    transform:
      translateY(110vh)
      translateX(80px)
      rotate(360deg);
    opacity:0;
  }

}

</style>
</head>

