    <div
      class="account-number"
      id="rekening"
    >
      1234567890
    </div>


    <div>
      a.n.
      <span id="pemilikRekening">
        Febriyanda
      </span>
    </div>


    <button
      class="copy-btn"
      onclick="salinRekening()"
    >
