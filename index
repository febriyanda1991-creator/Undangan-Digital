<!-- =========================================================
     MUSIK
========================================================= -->

<button
  class="music-btn"
  id="musicButton"
  onclick="toggleMusic()"
>
  ♪
</button>


<audio
  id="music"
  loop
  preload="auto"
></audio>


<script>

/* =========================================================
   MEMASUKKAN DATA OTOMATIS
========================================================= */

document.title =
  "The Wedding Of " +
  DATA.pria +
  " & " +
  DATA.wanita;


/* cover */

document.getElementById("coverNames").innerText =
  DATA.pria +
  " & " +
  DATA.wanita;


document.getElementById("coverDate").innerText =
  DATA.tanggalSingkat;


document.getElementById("coverPhoto").src =
  DATA.fotoCover;


/* couple */

document.getElementById("namaPria").innerText =
  DATA.pria;

document.getElementById("namaWanita").innerText =
  DATA.wanita;

document.getElementById("ortuPria").innerText =
  DATA.orangTuaPria;

document.getElementById("ortuWanita").innerText =
  DATA.orangTuaWanita;

document.getElementById("fotoPria").src =
  DATA.fotoPria;

document.getElementById("fotoWanita").src =
  DATA.fotoWanita;


/* marquee */

document.getElementById("marqueeText").innerText =
  "✦ " +
  DATA.pria.toUpperCase() +
  " & " +
  DATA.wanita.toUpperCase() +
  " ✦ THE WEDDING DAY ✦ " +
  DATA.tanggal.toUpperCase() +
  " ✦ LOVE FOREVER ✦";


/* event */

document.getElementById("tanggalAkad").innerText =
  DATA.tanggal;

document.getElementById("tanggalResepsi").innerText =
  DATA.tanggal;

document.getElementById("jamAkad").innerText =
  DATA.jamAkad;

document.getElementById("jamResepsi").innerText =
  DATA.jamResepsi;

document.getElementById("lokasiAkad").innerText =
  DATA.lokasi;

document.getElementById("lokasiResepsi").innerText =
  DATA.lokasi;

document.getElementById("alamatAkad").innerText =
  DATA.alamat;

document.getElementById("alamatResepsi").innerText =
  DATA.alamat;

document.getElementById("mapAkad").href =
  DATA.maps;

document.getElementById("mapResepsi").href =
  DATA.maps;


/* gallery */

document.getElementById("gallery1").src =
  DATA.foto1;

document.getElementById("gallery2").src =
  DATA.foto2;

document.getElementById("gallery3").src =
  DATA.foto3;

document.getElementById("gallery4").src =
  DATA.foto4;


/* gift */

document.getElementById("bank").innerText =
  DATA.bank;

document.getElementById("rekening").innerText =
  DATA.rekening;

document.getElementById("pemilikRekening").innerText =
  DATA.pemilikRekening;


/* footer */

document.getElementById("footerNames").innerText =
  DATA.pria +
  " & " +
  DATA.wanita;

document.getElementById("footerDate").innerText =
  DATA.tanggalSingkat;


/* =========================================================
   COUNTDOWN
========================================================= */

const weddingDate =
  new Date(DATA.tanggalCountdown).getTime();


function updateCountdown(){

  const now =
    new Date().getTime();

  const distance =
    weddingDate - now;


  if(distance <= 0){

    document.getElementById("days").innerText = "0";

    document.getElementById("hours").innerText = "0";

    document.getElementById("minutes").innerText = "0";

    document.getElementById("seconds").innerText = "0";

    return;

  }


  const days =
    Math.floor(
      distance /
      (1000 * 60 * 60 * 24)
    );


  const hours =
    Math.floor(
      (
        distance %
        (1000 * 60 * 60 * 24)
      ) /
      (1000 * 60 * 60)
    );


  const minutes =
    Math.floor(
      (
        distance %
        (1000 * 60 * 60)
      ) /
      (1000 * 60)
    );


  const seconds =
    Math.floor(
      (
        distance %
        (1000 * 60)
      ) /
      1000
    );


  document.getElementById("days").innerText =
    days;

  document.getElementById("hours").innerText =
    hours;

  document.getElementById("minutes").innerText =
    minutes;

  document.getElementById("seconds").innerText =
    seconds;

}


updateCountdown();

setInterval(
  updateCountdown,
  1000
);


/* =========================================================
   MUSIK
========================================================= */

const music =
  document.getElementById("music");

const musicButton =
  document.getElementById("musicButton");


let musicPlaying = false;


if(DATA.musik){

  music.src =
    DATA.musik;

}


function bukaUndangan(){

  if(DATA.musik){

    music.play()
      .then(function(){

        musicPlaying = true;

        musicButton.innerText =
          "❚❚";

        musicButton.classList.add(
          "playing"
        );

      })
      .catch(function(){

      });

  }

}


function toggleMusic(){

  if(!DATA.musik){

    alert(
      "Musik belum dipasang. Nanti upload file musik.mp3 ke repository."
    );

    return;

  }


  if(musicPlaying){

    music.pause();

    musicPlaying = false;

    musicButton.innerText =
      "♪";

    musicButton.classList.remove(
      "playing"
    );

  }

  else{

    music.play()
      .then(function(){

        musicPlaying = true;

        musicButton.innerText =
          "❚❚";

        musicButton.classList.add(
          "playing"
        );

      });

  }

}


/* =========================================================
   RSVP WHATSAPP
========================================================= */

function kirimRSVP(event){

  event.preventDefault();


  const nama =
    document.getElementById(
      "namaTamu"
    ).value;


  const kehadiran =
    document.getElementById(
      "kehadiran"
    ).value;


  const pesan =
    document.getElementById(
      "pesanTamu"
    ).value;


  const text =
    "Halo " +
    DATA.pria +
    " & " +
    DATA.wanita +
    ",%0A%0A" +

    "Saya " +
    encodeURIComponent(nama) +

    " ingin mengonfirmasi bahwa saya " +

    encodeURIComponent(
      kehadiran
    ) +

    " pada acara pernikahan.%0A%0A" +

    "Pesan:%20" +

    encodeURIComponent(
      pesan
    ) +

    "%0A%0ATerima kasih.";


  const url =
    "https://wa.me/" +
    DATA.whatsapp +
    "?text=" +
    text;


  window.open(
    url,
    "_blank"
  );

}


/* =========================================================
   COPY REKENING
========================================================= */

function salinRekening(){

  navigator.clipboard.writeText(
    DATA.rekening
  )
  .then(function(){

    alert(
      "Nomor rekening berhasil disalin."
    );

  });

}


/* =========================================================
   SCROLL REVEAL
========================================================= */

const observer =
  new IntersectionObserver(

    function(entries){

      entries.forEach(
        function(entry){

          if(
            entry.isIntersecting
          ){

            entry.target.classList.add(
              "show"
            );

          }

        }
      );

    },

    {
      threshold:.12
    }

  );


document
  .querySelectorAll(
    ".reveal"
  )
  .forEach(
    function(element){

      observer.observe(
        element
      );

    }
  );


/* =========================================================
   ANIMASI PETAL / BINTANG
========================================================= */

function createPetal(){

  const petal =
    document.createElement(
      "div"
    );


  petal.className =
    "petal";


  petal.innerText =
    Math.random() > .5
    ? "✦"
    : "✧";


  petal.style.left =
    Math.random() * 100 +
    "vw";


  petal.style.animationDuration =
    (5 + Math.random() * 5) +
    "s";


  petal.style.fontSize =
    (10 + Math.random() * 12) +
    "px";


  document.body.appendChild(
    petal
  );


  setTimeout(
    function(){

      petal.remove();

    },
    10000
  );

}


setInterval(
  createPetal,
  900
);

</script>

</body>
</html>
